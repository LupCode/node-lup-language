{
    "collectCoverage": true,
    "extensionsToTreatAsEsm": [".ts", ".tsx"],
    "moduleFileExtensions": ["ts", "tsx", "js", "jsx", "json", "node"],
    "moduleNameMapper": {
        "^(\\.{1,2}/.*)\\.js$": "$1"
    },
    "preset": "ts-jest/presets/default-esm",
    "roots": ["<rootDir>/src"],
    "testEnvironment": "node",
    "testMatch": [
        "**/__tests__/**/*.[jt]s?(x)",
        "**/?(*.)+(spec|test).[jt]s?(x)"
    ],
    "transform": {
        "^.+\\.(t|j)sx?$": [
            "ts-jest", 
            {
                "tsconfig": "tsconfig.test.json",
                "useESM": true
            }
        ]
    }
}