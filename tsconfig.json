{
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./lib",
    "target": "es2022",
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "isolatedModules": true,
    "declaration": true,
    "strict": true,
    "types": ["node"]
  },
  "include": ["src"],
  "exclude": ["node_modules", "**/__tests__/**"]
}