{
  "name": "lup-language",
  "version": "2.5.0",
  "type": "module",
  "description": "Node express middleware for detecting requested language",
  "files": [
    "lib/**/*"
  ],
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "import": "./lib/index.js",
      "types": "./lib/index.d.ts"
    }
  },
  "scripts": {
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --config jestconfig.json",
    "build": "tsc",
    "format": "prettier --write \"src/**/*.ts\" \"src/**/*.js\"",
    "lint": "tslint -p tsconfig.json",
    "prepublishOnly": "npm run lint && npm run build && npm test",
    "preversion": "npm run lint",
    "version": "npm run format && git add -A src",
    "postversion": "git push && git push --tags"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LupCode/node-lup-language.git"
  },
  "keywords": [
    "Express",
    "Middleware",
    "multi-language",
    "multi-lingual",
    "NextJS",
    "Next.js"
  ],
  "author": "LupCode.com",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/LupCode/node-lup-language/issues"
  },
  "homepage": "https://github.com/LupCode/node-lup-language#readme",
  "dependencies": {
    "lup-root": "^2.0.0"
  },
  "devDependencies": {
    "@types/jest": "30.0.0",
    "@types/node": "26.6.1",
    "baseline-browser-mapping": "^2.11.25",
    "jest": "30.5.1",
    "prettier": "3.9.8",
    "ts-jest": "29.4.12",
    "tslint": "6.1.3",
    "tslint-config-prettier": "1.18.0",
    "typescript": "6.0.3"
  },
  "allowScripts": {
    "@parcel/watcher@2.6.0": true,
    "unrs-resolver@1.12.2": true
  }
}
